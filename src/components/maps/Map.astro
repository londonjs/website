---
import { buildOsmEmbedUrl, buildOsmLink, buildOsmSearchLink } from '../../lib/osmMap';

interface Props {
  location: string;
  lat?: number;
  lon?: number;
  class?: string;
}

const { location, lat, lon, class: className = '' } = Astro.props;

const hasCoordinates = typeof lat === 'number' && typeof lon === 'number';
const embedUrl = hasCoordinates ? buildOsmEmbedUrl(lat, lon) : undefined;
const mapLink = hasCoordinates ? buildOsmLink(lat, lon) : buildOsmSearchLink(location);
---

<div
  class={`bg-white border-4 border-[#333333] rounded-3xl shadow-[4px_4px_0_#333333] overflow-hidden h-full ${className}`}
>
  <div class="aspect-video relative h-full">
    {hasCoordinates ? (
      <>
        <div class="absolute inset-0 bg-gray-100 animate-pulse" id="map-loading"></div>
        <iframe
          title={`Map showing ${location}`}
          width="100%"
          height="100%"
          style="border:0"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          src={embedUrl}
          class="absolute inset-0 z-10"
          onload="document.getElementById('map-loading').style.display='none'"
          onerror="document.getElementById('map-error').style.display='flex'"
        >
          </iframe>
        <div
          id="map-error"
          class="absolute inset-0 bg-white hidden items-center justify-center text-gray-600 z-20"
        >
          <div class="text-center">
            <p class="mb-2">Unable to load map</p>
            <a
              href={mapLink}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#333333] hover:underline"
            >
              View on OpenStreetMap →
            </a>
          </div>
        </div>
      </>
    ) : (
      <div class="absolute inset-0 bg-white flex items-center justify-center text-gray-600">
        <div class="text-center">
          <a
            href={mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#333333] hover:underline"
          >
            View on OpenStreetMap →
          </a>
        </div>
      </div>
    )}
  </div>
</div>
