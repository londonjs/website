{
  "name": "londonjs",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "vite": "astro dev --host --port 5173",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "prepare": "husky",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2",
      "prettier --write"
    ],
    "*.{css,json}": [
      "prettier --write"
    ],
    "*": [
      "gitleaks protect --staged --no-banner"
    ]
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.13",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "node-html-parser": "^9.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.5",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6",
    "typescript-eslint": "^8.73.0",
    "vi": "^1.0.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.0": true,
    "sharp@0.34.5": true
  },
  "overrides": {
    "markdownlint-cli2": {
      "js-yaml": "^5.2.2"
    },
    "postcss-selector-parser": "^6.1.5",
    "katex": "^0.19.1"
  }
}
